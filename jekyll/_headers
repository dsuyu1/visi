# Cloudflare Pages response headers. Only the support pages get a CSP for now,
# because they are the only pages that load third party code (Turnstile).
/support/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://intake.visiutrgv.org; form-action 'self' https://visiutrgv.org https://intake.visiutrgv.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
